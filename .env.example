# Public base URL of the deployment — the domain assigned in Coolify.
# Short links are minted on this domain.
APP_URL=https://hct.gg

# Password for the admin dashboard login.
ADMIN_PASSWORD=change-me

# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Optional overrides
#PORT=3000
#DATA_DIR=/data
