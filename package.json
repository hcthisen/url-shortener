{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted URL shortener with a minimal UI and full REST API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && vite build && node scripts/copy-scalar.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@scalar/api-reference": "^1.28.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.3.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
